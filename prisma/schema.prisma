// This is your Prisma schema file for CampusHire (PostgreSQL)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OFFICER
  STUDENT
  ADMIN
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
}

enum OfferType {
  REGULAR
  DREAM
  SUPER_DREAM
  INTERNSHIP
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student?

  @@map("users")
}

model Student {
  id               String        @id @default(cuid())
  userId           String?       @unique
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  rollNo           String        @unique
  branch           String
  batch            String        @default("2027")
  cgpa             Float
  backlogs         Int           @default(0)
  email            String        @unique
  phone            String
  skills           String[]
  placed           Boolean       @default(false)
  placedCompany    String?
  placedPackageLpa String?
  offerType        OfferType?
  resumeUrl        String?
  applications     Application[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("students")
}

model Company {
  id             String    @id @default(cuid())
  name           String    @unique
  industry       String
  location       String
  website        String
  about          String
  hrName         String
  hrRole         String    @default("Campus Talent Lead")
  hrEmail        String
  hrPhone        String
  totalHires     Int       @default(0)
  avgPackageLpa  String?
  highestPackage String?
  hiringSince    String?
  vacancies      Vacancy[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("companies")
}

model Vacancy {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName      String
  roleTitle        String
  employmentType   String        @default("Full-time")
  location         String
  packageLpa       String
  minCgpa          Float
  eligibleBranches String[]
  requiredSkills   String[]
  batch            String        @default("2027")
  deadline         DateTime
  description      String
  status           VacancyStatus @default(DRAFT)
  backlogsAllowed  Int           @default(0)
  applicantsCount  Int           @default(0)
  applications     Application[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("vacancies")
}

model Application {
  id        String            @id @default(cuid())
  vacancyId String
  vacancy   Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  notes     String?
  appliedOn DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([vacancyId, studentId])
  @@map("applications")
}
